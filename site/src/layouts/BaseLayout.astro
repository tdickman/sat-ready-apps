---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  additionalSchemas?: Record<string, unknown>[];
}

const {
  title = "Android Apps for Limited Satellite Data",
  description = "Browse Android apps whose APK manifests include Android's setting for limited satellite data connections.",
  image = "/social-card.png",
  imageAlt = "SatReady Apps: Android apps for limited satellite data",
  noindex = false,
  additionalSchemas = [],
} = Astro.props;
const siteName = "SatReady Apps";
const siteDescription = "A searchable catalog of Android apps whose APK manifests include Android's setting for limited satellite data connections.";
const pageTitle = title === siteName ? title : `${title} | ${siteName}`;
const siteOrigin = Astro.site ?? Astro.url;
const siteUrl = new URL("/", siteOrigin);
const canonicalPath = Astro.url.pathname === "/"
  ? "/"
  : `${Astro.url.pathname.replace(/\/+$/, "")}/`;
const canonicalUrl = new URL(canonicalPath, siteOrigin);
const socialImageUrl = new URL(image, siteOrigin);
const websiteSchema = {
  "@type": "WebSite",
  "@id": `${siteUrl.href}#website`,
  name: siteName,
  url: siteUrl.href,
  description: siteDescription,
};
const webpageSchema = {
  "@type": "WebPage",
  "@id": `${canonicalUrl.href}#webpage`,
  name: pageTitle,
  url: canonicalUrl.href,
  description,
  isPartOf: { "@id": `${siteUrl.href}#website` },
};
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [websiteSchema, webpageSchema, ...additionalSchemas],
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="application-name" content={siteName} />
    <meta name="theme-color" content="#20312c" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={socialImageUrl.href} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl.href} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="alternate" type="application/rss+xml" title="SatReady Apps updates" href={new URL("/feed.xml", siteOrigin).href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={structuredData} />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="satready/apps home">
          <span class="wordmark-mark" aria-hidden="true">✦</span>
          <span>satready<span class="wordmark-accent">/</span>apps</span>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
          <a href="/">Apps</a>
          <a href="/updates/">Updates</a>
          <a href="/service/">Service</a>
          <a href="/supported-phones/">Phones</a>
          <a href="/developers/">Developers</a>
          <a href="/submit/">Suggest an app</a>
        </nav>
      </header>
      <main><slot /></main>
      <footer class="site-footer">
        <span>Apps checked for Android's limited-satellite-data setting.</span>
        <span class="footer-dot" aria-hidden="true"></span>
        <a href="/methodology/">How we check</a>
        <span class="footer-dot" aria-hidden="true"></span>
        <span>satreadyapps.com</span>
      </footer>
    </div>
  </body>
</html>
