<div class="search-panel">
  <label for="app-search">Search apps</label>
  <div class="search-input-wrap">
    <span class="search-icon" aria-hidden="true">⌕</span>
    <input id="app-search" type="search" placeholder="Search by app name or Android app ID" autocomplete="off" spellcheck="false" />
  </div>
  <p id="search-results" class="search-results" aria-live="polite"></p>
</div>

<script>
  const input = document.querySelector<HTMLInputElement>("#app-search");
  const searchGrid = document.querySelector<HTMLElement>('.app-grid[data-searchable="true"]');
  const cards = searchGrid ? Array.from(searchGrid.querySelectorAll<HTMLElement>(".app-card")) : [];
  const emptyState = searchGrid?.dataset.emptyState
    ? document.getElementById(searchGrid.dataset.emptyState)
    : null;
  const resultSummary = document.querySelector<HTMLElement>("#search-results");

  if (input && emptyState && resultSummary) {
    const updateResults = () => {
      const query = input.value.trim().toLocaleLowerCase();
      let visibleCount = 0;

      for (const card of cards) {
        const appName = card.dataset.appName?.toLocaleLowerCase() ?? "";
        const packageName = card.dataset.packageName?.toLocaleLowerCase() ?? "";
        const visible = !query || appName.includes(query) || packageName.includes(query);
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      }

      emptyState.hidden = cards.length > 0 && visibleCount !== 0;
      resultSummary.textContent = cards.length === 0
        ? "0 apps in the catalog"
        : query
          ? `${visibleCount} ${visibleCount === 1 ? "app" : "apps"} found`
          : `${visibleCount} ${visibleCount === 1 ? "app" : "apps"} in the catalog`;
    };

    input.addEventListener("input", updateResults);
    updateResults();

    document.addEventListener("keydown", (event) => {
      if (event.key === "/" && document.activeElement !== input && !["INPUT", "TEXTAREA"].includes((document.activeElement as HTMLElement)?.tagName ?? "")) {
        event.preventDefault();
        input.focus();
      }
    });
  }
</script>
