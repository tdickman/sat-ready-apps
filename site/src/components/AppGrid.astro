---
import AppCard from "./AppCard.astro";
import type { CatalogApp } from "../lib/catalog";

interface Props {
  apps: CatalogApp[];
}

const { apps } = Astro.props;
---

<div id="app-grid" class="app-grid" aria-label="Catalog apps">
  {apps.map((app) => <AppCard app={app} />)}
</div>
<p id="no-results" class="empty-state" hidden={apps.length > 0}>
  {apps.length > 0 ? "No apps found. Try a different name." : "No apps in the catalog yet. The next crawl will add verified results."}
</p>
