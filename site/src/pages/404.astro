---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found">
  <section class="not-found" aria-labelledby="not-found-title">
    <p class="section-eyebrow">Signal lost / 404</p>
    <h1 id="not-found-title">This app is not<br /><em>in the catalog.</em></h1>
    <p>That route does not point to a verified satellite-ready app. Return to the catalog to browse the current list.</p>
    <a class="button button-primary" href="/">Back to catalog <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
