---
import BaseLayout from "../layouts/BaseLayout.astro";

const phoneGroups = [
  {
    brand: "Apple",
    models: [
      "iPhone 13 family (all models)",
      "iPhone 14 family",
      "iPhone 15 family",
      "iPhone 16 family",
      "iPhone 17",
      "iPhone 17 Pro",
      "iPhone 17 Pro Max",
      "iPhone 17e",
      "iPhone Air",
    ],
  },
  {
    brand: "Google",
    models: [
      "Pixel 9",
      "Pixel 9a",
      "Pixel 9 Pro",
      "Pixel 9 Pro XL",
      "Pixel 9 Pro Fold",
      "Pixel 10",
      "Pixel 10a",
      "Pixel 10 Pro",
      "Pixel 10 Pro XL",
      "Pixel 10 Pro Fold",
    ],
  },
  {
    brand: "Samsung",
    models: [
      "Galaxy A15 5G",
      "Galaxy A16 5G SE",
      "Galaxy A17 5G",
      "Galaxy A35",
      "Galaxy A36 5G",
      "Galaxy A37 5G",
      "Galaxy A54 5G",
      "Galaxy A57 5G",
      "Galaxy S21 family",
      "Galaxy S22 family",
      "Galaxy S23 family",
      "Galaxy S23 FE",
      "Galaxy S24",
      "Galaxy S24+",
      "Galaxy S24 Ultra",
      "Galaxy S25",
      "Galaxy S25+",
      "Galaxy S25 Ultra",
      "Galaxy S25 Edge",
      "Galaxy S25 FE",
      "Galaxy S26",
      "Galaxy S26+",
      "Galaxy S26 Ultra",
      "Galaxy Z Flip3 5G through Z Flip5",
      "Galaxy Z Flip6",
      "Galaxy Z Flip7",
      "Galaxy Z Flip8",
      "Galaxy Z Fold3 5G through Z Fold5",
      "Galaxy Z Fold6",
      "Galaxy Z Fold7",
      "Galaxy Z Fold8",
      "Galaxy Z Fold8 Ultra",
      "Galaxy XCover6 Pro",
      "Galaxy XCover7 Pro 5G",
    ],
  },
  {
    brand: "Motorola",
    models: [
      "moto edge 2024",
      "edge - 2025",
      "moto g 5G (2024)",
      "moto g stylus 5G (2024)",
      "moto g - 2026",
      "moto g play - 2026",
      "moto g stylus - 2026",
      "moto razr 2024",
      "razr - 2025",
      "razr+ 2025",
      "razr ultra - 2025",
      "razr - 2026",
      "razr fold - 2026",
      "razr - Swarovski",
    ],
  },
  {
    brand: "TCL",
    models: ["NXTPAPER 70 Pro", "FLIP 4"],
  },
  {
    brand: "T-Mobile",
    models: ["REVVL 7", "REVVL 7 Pro", "REVVL 8", "REVVL 8 Pro"],
  },
  {
    brand: "Sonim",
    models: ["XP Pro", "XP3plus 5G", "XP3plus 5G Non-Camera Version"],
  },
];

const checkedDate = "August 8, 2026";
const tMobileSupportUrl = "https://www.t-mobile.com/support/coverage/satellite-support";
const tMobilePhonesUrl = "https://www.t-mobile.com/cell-phones/network/satellite";
const tMobileBusinessUrl = "https://www.t-mobile.com/support/business/T-Mobile-for-Business-Satellite-Support";
const imeiUrl = "https://www.t-mobile.com/resources/bring-your-own-phone#phone-check";
---

<BaseLayout
  title="Supported phones"
  description="Phones listed by T-Mobile as supporting at least one T-Satellite feature, with links to the original information."
>
  <article class="info-page">
    <header class="info-hero">
      <h1>Supported phones</h1>
      <p class="info-lead">These phones appear on T-Mobile's current support pages for at least one T-Satellite feature. This does not mean every phone supports satellite app data. Support can vary by phone version, software, plan, and feature, so check your phone using its IMEI, the identification number found in its settings.</p>
      <a class="button button-secondary" href={imeiUrl} target="_blank" rel="noreferrer">Check your phone with T-Mobile <span aria-hidden="true">↗</span></a>
    </header>

    <section class="info-section" aria-labelledby="phones-heading">
      <div class="info-section-heading">
        <h2 id="phones-heading">Phones listed by T-Mobile</h2>
        <p>Last checked {checkedDate}. When we list a phone family or range, T-Mobile names that family or lists every model in it.</p>
      </div>

      <div class="supported-phone-list">
        {phoneGroups.map((group) => (
          <section class="supported-phone-group" aria-labelledby={`brand-${group.brand.toLowerCase().replaceAll(" ", "-")}`}>
            <h3 id={`brand-${group.brand.toLowerCase().replaceAll(" ", "-")}`}>{group.brand}</h3>
            <ul role="list">
              {group.models.map((model) => <li>{model}</li>)}
            </ul>
          </section>
        ))}
      </div>
    </section>

    <section class="info-section methodology" aria-labelledby="method-heading">
      <div class="info-section-heading">
        <h2 id="method-heading">How this list was made</h2>
      </div>
      <dl class="method-list">
        <div>
          <dt>Included</dt>
          <dd>A phone is included when T-Mobile lists the model or phone family in its Satellite Connected Phones list, phone setup guides, or T-Satellite setup instructions.</dd>
        </div>
        <div>
          <dt>What we don't assume</dt>
          <dd>Phones are not added based only on built-in satellite technology, an announcement from the phone maker, emergency SOS support, or similarity to another supported model.</dd>
        </div>
        <div>
          <dt>What “supported” means</dt>
          <dd>The phone is documented for at least one T-Satellite feature. It does not mean every phone above supports satellite app data. Messaging, location, emergency, and data availability differ by model and account.</dd>
        </div>
        <div>
          <dt>Final check</dt>
          <dd>T-Mobile's IMEI checker gives the final answer for your phone. Support can depend on the version of the phone model, software, SIM or eSIM, service plan, location, and whether T-Mobile has enabled the feature yet.</dd>
        </div>
      </dl>

      <h3 class="sources-heading">Sources checked</h3>
      <div class="source-links">
        <a href={tMobilePhonesUrl} target="_blank" rel="noreferrer">Satellite Connected Phones <span aria-hidden="true">↗</span></a>
        <a href={tMobileSupportUrl} target="_blank" rel="noreferrer">T-Satellite support and phone setup guides <span aria-hidden="true">↗</span></a>
        <a href={tMobileBusinessUrl} target="_blank" rel="noreferrer">Phone information for business customers <span aria-hidden="true">↗</span></a>
        <a href={imeiUrl} target="_blank" rel="noreferrer">T-Mobile IMEI checker <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </article>
</BaseLayout>
