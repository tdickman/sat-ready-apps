---
import AppGrid from "../components/AppGrid.astro";
import SearchBar from "../components/SearchBar.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { apps, formatCatalogDate, getRecentApps, meta } from "../lib/catalog";

const generatedAt = typeof meta?.generated_at === "string" ? meta.generated_at : null;
const formattedGeneratedDate = formatCatalogDate(generatedAt);
const recentApps = getRecentApps(6);
const pageDescription = "Search a manifest-verified catalog of Android apps with Android's limited-satellite-data setting, package names, verification dates, and official download links.";
const siteOrigin = Astro.site ?? Astro.url;
const catalogUrl = new URL("/", siteOrigin).href;
const catalogItems = apps.map((app, index) => ({
  "@type": "ListItem",
  position: index + 1,
  name: app.app_name,
  url: new URL(`/apps/${encodeURIComponent(app.package_name)}/`, siteOrigin).href,
}));
---

<BaseLayout
  title="Android apps for satellite data"
  description={pageDescription}
  additionalSchemas={[{
    "@type": "CollectionPage",
    "@id": `${catalogUrl}#catalog`,
    name: "SatReady Apps catalog",
    url: catalogUrl,
    description: pageDescription,
    mainEntity: { "@id": `${catalogUrl}#app-list` },
  }, {
    "@type": "ItemList",
    "@id": `${catalogUrl}#app-list`,
    name: "Manifest-verified Android satellite apps",
    numberOfItems: apps.length,
    itemListElement: catalogItems,
  }]}
>
  <section class="catalog-hero" aria-labelledby="page-title">
    <h1 id="page-title">Android apps for satellite data</h1>
    <p class="hero-intro">We check each app for an Android setting that indicates it is designed to work with limited satellite data. Some features may still not work with your mobile provider's satellite service.</p>
    <div class="catalog-meta" aria-label="Catalog status">
      <span><strong>{apps.length}</strong> checked {apps.length === 1 ? "app" : "apps"}</span>
      <span class="meta-rule" aria-hidden="true"></span>
      <span>{formattedGeneratedDate ? `Catalog updated ${formattedGeneratedDate}` : "Catalog update pending"}</span>
    </div>
  </section>

  <section class="catalog-section recent-section" aria-labelledby="recent-heading">
    <div class="section-heading-row">
      <div>
        <p class="section-eyebrow">Latest additions</p>
        <h2 id="recent-heading">Recently added apps</h2>
      </div>
      <a class="inline-link" href="/updates/">View all updates <span aria-hidden="true">↗</span></a>
    </div>
    {recentApps.length > 0 ? (
      <AppGrid apps={recentApps} showAddedDate gridId="recent-app-grid" emptyStateId="recent-no-results" />
    ) : (
      <p class="empty-state">No additions have been recorded yet.</p>
    )}
  </section>

  <section class="catalog-section" aria-labelledby="catalog-heading">
    <h2 id="catalog-heading">Browse apps</h2>
    <SearchBar />
    <AppGrid apps={apps} gridId="catalog-app-grid" emptyStateId="catalog-no-results" searchable />
  </section>

  <section class="catalog-note" aria-labelledby="requirements-heading">
    <h2 id="requirements-heading">Before using an app over satellite</h2>
    <p>An app being listed here is only one requirement. You also need a <a href="/supported-phones/">supported phone</a>, <a href="/service/">satellite service</a>, and confirmation that your mobile provider supports the app and feature you want to use. Read <a href="/methodology/">how the catalog check works</a> to understand what a listing does and does not confirm.</p>
  </section>
</BaseLayout>
