---
import AppGrid from "../components/AppGrid.astro";
import SearchBar from "../components/SearchBar.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { apps, meta } from "../lib/catalog";

const generatedAt = typeof meta?.generated_at === "string" ? meta.generated_at : null;
const generatedDate = generatedAt ? new Date(generatedAt) : null;
const formattedGeneratedDate = generatedDate && !Number.isNaN(generatedDate.valueOf())
  ? generatedDate.toLocaleDateString("en", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })
  : null;
const pageDescription = "Browse Android apps that include Android's setting for limited satellite data connections.";
---

<BaseLayout
  title="Android apps for satellite data"
  description={pageDescription}
  additionalSchemas={[{
    "@type": "CollectionPage",
    "@id": "https://satreadyapps.com/#catalog",
    name: "SatReady Apps catalog",
    url: "https://satreadyapps.com/",
    description: pageDescription,
  }]}
>
  <section class="catalog-hero" aria-labelledby="page-title">
    <h1 id="page-title">Android apps for satellite data</h1>
    <p class="hero-intro">We check each app for an Android setting that indicates it is designed to work with limited satellite data. Some features may still not work with your mobile provider's satellite service.</p>
    <div class="catalog-meta" aria-label="Catalog status">
      <span><strong>{apps.length}</strong> checked {apps.length === 1 ? "app" : "apps"}</span>
      <span class="meta-rule" aria-hidden="true"></span>
      <span>{formattedGeneratedDate ? `Catalog updated ${formattedGeneratedDate}` : "Catalog update pending"}</span>
    </div>
  </section>

  <section class="catalog-section" aria-labelledby="catalog-heading">
    <h2 id="catalog-heading">Browse apps</h2>
    <SearchBar />
    <AppGrid apps={apps} />
  </section>

  <section class="catalog-note" aria-labelledby="requirements-heading">
    <h2 id="requirements-heading">Before using an app over satellite</h2>
    <p>An app being listed here is only one requirement. You also need a <a href="/supported-phones/">supported phone</a>, <a href="/service/">satellite service</a>, and confirmation that your mobile provider supports the app and feature you want to use.</p>
  </section>
</BaseLayout>
