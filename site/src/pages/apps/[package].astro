---
import AppGrid from "../../components/AppGrid.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { apps, formatCatalogDate } from "../../lib/catalog";

export function getStaticPaths() {
  return apps.map((app) => ({
    params: { package: app.package_name },
    props: { app },
  }));
}

const { app } = Astro.props;
const initial = app.app_name.trim().charAt(0).toUpperCase() || "?";
const verifiedDate = app.last_verified ? new Date(app.last_verified) : null;
const formattedVerifiedDate = verifiedDate && !Number.isNaN(verifiedDate.valueOf())
  ? verifiedDate.toLocaleDateString("en", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" })
  : "Not available";
const formattedAddedDate = formatCatalogDate(app.first_verified_at, true) ?? "Not available";
const pageDescription = `${app.app_name} is listed in a manifest-verified catalog of Android apps with a constrained-satellite-data declaration. See its Android app ID, verification date, and official download links.`;
const detailPath = `${Astro.url.pathname.replace(/\/+$/, "")}/`;
const detailUrl = new URL(detailPath, Astro.site ?? Astro.url).href;
const storeUrls = [app.play_store_url, app.fdroid_url].filter((url): url is string => Boolean(url));
const relatedApps = app.category
  ? apps
    .filter((candidate) => candidate.package_name !== app.package_name && candidate.category === app.category)
    .sort((left, right) => left.app_name.localeCompare(right.app_name))
    .slice(0, 4)
  : [];
---

<BaseLayout
  title={`${app.app_name} satellite app check`}
  description={pageDescription}
  additionalSchemas={[{
    "@type": "SoftwareApplication",
    "@id": `${detailUrl}#software-application`,
    name: app.app_name,
    description: pageDescription,
    url: detailUrl,
    identifier: app.package_name,
    operatingSystem: "Android",
    ...(app.category ? { applicationCategory: app.category } : {}),
    ...(app.icon_url ? { image: app.icon_url } : {}),
    ...(storeUrls.length ? { sameAs: storeUrls } : {}),
    ...(app.last_verified ? { dateModified: app.last_verified } : {}),
  }, {
    "@type": "BreadcrumbList",
    "@id": `${detailUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Catalog", item: "https://satreadyapps.com/" },
      { "@type": "ListItem", position: 2, name: app.app_name, item: detailUrl },
    ],
  }]}
>
  <article class="detail-page">
    <a class="back-link" href="/">← Back to catalog</a>
    <div class="detail-layout">
      <div class="detail-icon app-icon" aria-hidden="true">
        {app.icon_url ? (
          <>
            <img src={app.icon_url} alt="" width="256" height="256" decoding="async" onerror="this.hidden=true; this.nextElementSibling.hidden=false" />
            <span class="icon-fallback" hidden>{initial}</span>
          </>
        ) : (
          <span class="icon-fallback">{initial}</span>
        )}
      </div>
      <div class="detail-content">
        <p class="section-eyebrow">Satellite data check</p>
        <h1>{app.app_name}</h1>
        <p class="detail-description">We checked an Android installation file for this app on the date shown. It included Android's setting for apps designed to use limited satellite data. The Android app ID is <code class="inline-code">{app.package_name}</code>. The version currently in the app store may be different, and some features may not work with your mobile provider's satellite service. Also check your phone, plan, and provider's supported-app list. <a href="/methodology/">Learn how this catalog check works.</a></p>
        <div class="detail-actions">
          {app.play_store_url && <a class="button button-primary" href={app.play_store_url} rel="noreferrer">Google Play <span aria-hidden="true">↗</span></a>}
          {app.fdroid_url && <a class="button button-secondary" href={app.fdroid_url} rel="noreferrer">F-Droid <span aria-hidden="true">↗</span></a>}
        </div>
      </div>
      <dl class="detail-facts">
        <div>
          <dt>Last checked</dt>
          <dd><time datetime={app.last_verified}>{formattedVerifiedDate}</time></dd>
        </div>
        <div>
          <dt>Added to catalog</dt>
          <dd><time datetime={app.first_verified_at}>{formattedAddedDate}</time></dd>
        </div>
        {app.category && (
          <div>
            <dt>Category</dt>
            <dd>{app.category}</dd>
          </div>
        )}
        <div>
          <dt>Android app ID</dt>
          <dd class="app-id">{app.package_name}</dd>
        </div>
      </dl>
    </div>
  </article>
  {relatedApps.length > 0 && (
    <section class="catalog-section" aria-labelledby="related-apps-heading">
      <div class="section-heading-row">
        <div>
          <p class="section-eyebrow">More in {app.category}</p>
          <h2 id="related-apps-heading">Related verified apps</h2>
        </div>
        <a class="inline-link" href="/">Browse the full catalog <span aria-hidden="true">↗</span></a>
      </div>
      <AppGrid apps={relatedApps} gridId="related-app-grid" emptyStateId="related-no-results" />
    </section>
  )}
</BaseLayout>
