---
import BaseLayout from "../layouts/BaseLayout.astro";

const repositoryUrl = "https://github.com/tdickman/sat-ready-apps";
const issueUrl = "https://github.com/tdickman/sat-ready-apps/issues/new";
const seedListUrl = "https://github.com/tdickman/sat-ready-apps/blob/main/crawler/seed_list.json";
---

<BaseLayout
  title="Submit"
  description="Suggest an Android app for the SatReady Apps catalog through GitHub."
>
  <article class="info-page">
    <header class="info-hero">
      <p class="section-eyebrow">Community / GitHub</p>
      <h1>Add to the<br /><em>signal.</em></h1>
      <p class="info-lead">Suggest an Android app for the catalog. We check its released APK for the satellite optimization declaration before listing it.</p>
    </header>

    <section class="info-section" aria-labelledby="submit-heading">
      <div class="info-section-heading">
        <p class="section-eyebrow">Choose a path</p>
        <h2 id="submit-heading">Issue or pull request.</h2>
      </div>
      <div class="submit-actions">
        <article class="submit-action">
          <h3>Nominate an app</h3>
          <p>Open an issue with the package name, store link, and any supporting details.</p>
          <a class="button button-primary" href={issueUrl} target="_blank" rel="noreferrer">New GitHub issue <span aria-hidden="true">↗</span></a>
        </article>
        <article class="submit-action">
          <h3>Contribute a package</h3>
          <p>Add the package to <code class="inline-code">crawler/seed_list.json</code> and open a pull request.</p>
          <a class="button button-secondary" href={repositoryUrl} target="_blank" rel="noreferrer">View repository <span aria-hidden="true">↗</span></a>
        </article>
      </div>
    </section>

    <section class="info-section" aria-labelledby="details-heading">
      <div class="info-section-heading">
        <p class="section-eyebrow">What to include</p>
        <h2 id="details-heading">Keep it useful.</h2>
      </div>
      <ul class="check-list">
        <li>The exact Android package name, such as <code class="inline-code">com.example.app</code>.</li>
        <li>A Google Play or F-Droid link, if available.</li>
        <li>The release version or evidence that suggests satellite support.</li>
      </ul>
      <div class="submit-note">
        <p>Catalog data is generated. Do not edit the catalog output directly. The next crawl checks <code class="inline-code">android.telephony.PROPERTY_SATELLITE_DATA_OPTIMIZED</code> and lists a package only when the declaration is found.</p>
      </div>
    </section>

    <section class="info-section" aria-labelledby="repository-heading">
      <p class="section-eyebrow">Open source</p>
      <h2 id="repository-heading">See the project.</h2>
      <div class="source-links">
        <a href={seedListUrl} target="_blank" rel="noreferrer">Seed list <span aria-hidden="true">↗</span></a>
        <a href={`${repositoryUrl}/issues`} target="_blank" rel="noreferrer">Issues <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </article>
</BaseLayout>
